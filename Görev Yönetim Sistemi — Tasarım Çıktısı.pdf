ant-baseline: middle; font-size: 10.2px;">PK</text><rect class="er attributeBoxOdd" x="135.60000133514404" y="26" width="170" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-1-comment" x="0" y="0" transform="translate(140.60000133514404,38.200000286102295)" style="dominant-baseline: middle; font-size: 10.2px;"></text><rect class="er attributeBoxEven" x="0" y="50.40000057220459" width="52.400001525878906" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-2-type" x="0" y="0" transform="translate(5,62.600000858306885)" style="dominant-baseline: middle; font-size: 10.2px;">string</text><rect class="er attributeBoxEven" x="52.400001525878906" y="50.40000057220459" width="62" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-2-name" x="0" y="0" transform="translate(57.400001525878906,62.600000858306885)" style="dominant-baseline: middle; font-size: 10.2px;">name</text><rect class="er attributeBoxEven" x="114.4000015258789" y="50.40000057220459" width="21.199999809265137" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-2-key" x="0" y="0" transform="translate(119.4000015258789,62.600000858306885)" style="dominant-baseline: middle; font-size: 10.2px;"></text><rect class="er attributeBoxEven" x="135.60000133514404" y="50.40000057220459" width="170" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-2-comment" x="0" y="0" transform="translate(140.60000133514404,62.600000858306885)" style="dominant-baseline: middle; font-size: 10.2px;"></text><rect class="er attributeBoxOdd" x="0" y="74.80000114440918" width="52.400001525878906" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-3-type" x="0" y="0" transform="translate(5,87.00000143051147)" style="dominant-baseline: middle; font-size: 10.2px;">string</text><rect class="er attributeBoxOdd" x="52.400001525878906" y="74.80000114440918" width="62" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-3-name" x="0" y="0" transform="translate(57.400001525878906,87.00000143051147)" style="dominant-baseline: middle; font-size: 10.2px;">description</text><rect class="er attributeBoxOdd" x="114.4000015258789" y="74.80000114440918" width="21.199999809265137" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-3-key" x="0" y="0" transform="translate(119.4000015258789,87.00000143051147)" style="dominant-baseline: middle; font-size: 10.2px;"></text><rect class="er attributeBoxOdd" x="135.60000133514404" y="74.80000114440918" width="170" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-3-comment" x="0" y="0" transform="translate(140.60000133514404,87.00000143051147)" style="dominant-baseline: middle; font-size: 10.2px;"></text><rect class="er attributeBoxEven" x="0" y="99.20000171661377" width="52.400001525878906" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-4-type" x="0" y="0" transform="translate(5,111.40000200271606)" style="dominant-baseline: middle; font-size: 10.2px;">string</text><rect class="er attributeBoxEven" x="52.400001525878906" y="99.20000171661377" width="62" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-4-name" x="0" y="0" transform="translate(57.400001525878906,111.40000200271606)" style="dominant-baseline: middle; font-size: 10.2px;">status</text><rect class="er attributeBoxEven" x="114.4000015258789" y="99.20000171661377" width="21.199999809265137" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-4-key" x="0" y="0" transform="translate(119.4000015258789,111.40000200271606)" style="dominant-baseline: middle; font-size: 10.2px;"></text><rect class="er attributeBoxEven" x="135.60000133514404" y="99.20000171661377" width="170" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-4-comment" x="0" y="0" transform="translate(140.60000133514404,111.40000200271606)" style="dominant-baseline: middle; font-size: 10.2px;">ACTIVE | ON_HOLD | COMPLETED</text><rect class="er attributeBoxOdd" x="0" y="123.60000228881836" width="52.400001525878906" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-5-type" x="0" y="0" transform="translate(5,135.80000257492065)" style="dominant-baseline: middle; font-size: 10.2px;">datetime</text><rect class="er attributeBoxOdd" x="52.400001525878906" y="123.60000228881836" width="62" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-5-name" x="0" y="0" transform="translate(57.400001525878906,135.80000257492065)" style="dominant-baseline: middle; font-size: 10.2px;">createdAt</text><rect class="er attributeBoxOdd" x="114.4000015258789" y="123.60000228881836" width="21.199999809265137" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-5-key" x="0" y="0" transform="translate(119.4000015258789,135.80000257492065)" style="dominant-baseline: middle; font-size: 10.2px;"></text><rect class="er attributeBoxOdd" x="135.60000133514404" y="123.60000228881836" width="170" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-5-comment" x="0" y="0" transform="translate(140.60000133514404,135.80000257492065)" style="dominant-baseline: middle; font-size: 10.2px;"></text><rect class="er attributeBoxEven" x="0" y="148.00000286102295" width="52.400001525878906" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-6-type" x="0" y="0" transform="translate(5,160.20000314712524)" style="dominant-baseline: middle; font-size: 10.2px;">datetime</text><rect class="er attributeBoxEven" x="52.400001525878906" y="148.00000286102295" width="62" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-6-name" x="0" y="0" transform="translate(57.400001525878906,160.20000314712524)" style="dominant-baseline: middle; font-size: 10.2px;">updatedAt</text><rect class="er attributeBoxEven" x="114.4000015258789" y="148.00000286102295" width="21.199999809265137" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-6-key" x="0" y="0" transform="translate(119.4000015258789,160.20000314712524)" style="dominant-baseline: middle; font-size: 10.2px;"></text><rect class="er attributeBoxEven" x="135.60000133514404" y="148.00000286102295" width="170" height="24.40000057220459"></rect><text class="er entityLabel" id="text-entity-PROJECT-7694b060-3426-5f95-980b-c6c423c4d7b8-attr-6-comment" x="0" y="0" transform="translate(140.60000133514404,160.20000314712524)" style="dominant-baseline: middle; font-size: 10.2px;"></text></g><rect class="er relationshipLabelBox" x="133.95583724975586" y="241.26190185546875" width="90.4000015258789" height="16"></rect><text class="er relationshipLabel" id="rel1" x="179.1558380126953" y="249.26190185546875" style="text-anchor: middle; dominant-baseline: middle; font-size: 12px;">atanır (assignee)</text><rect class="er relationshipLabelBox" x="537.6441650390625" y="241.26190185546875" width="28" height="16"></rect><text class="er relationshipLabel" id="rel2" x="551.6441650390625" y="249.26190185546875" style="text-anchor: middle; dominant-baseline: middle; font-size: 12px;">içerir</text></svg></div>

<h2>2.2 Varlık Açıklamaları</h2>

<h3>Employee (Çalışan)</h3>
<table>
  <tbody><tr><th>Alan</th><th>Tip</th><th>Açıklama</th></tr>
  <tr><td>id</td><td>Int</td><td>Birincil anahtar</td></tr>
  <tr><td>name</td><td>String</td><td>Ad soyad</td></tr>
  <tr><td>email</td><td>String</td><td>Benzersiz e-posta</td></tr>
  <tr><td>role</td><td>String</td><td>ADMIN / MANAGER / EMPLOYEE (varsayılan: EMPLOYEE)</td></tr>
  <tr><td>tasks</td><td>Task[]</td><td>Çalışana atanan görevler (1-N)</td></tr>
</tbody></table>

<h3>Project (Proje)</h3>
<table>
  <tbody><tr><th>Alan</th><th>Tip</th><th>Açıklama</th></tr>
  <tr><td>id</td><td>Int</td><td>Birincil anahtar</td></tr>
  <tr><td>name</td><td>String</td><td>Proje adı</td></tr>
  <tr><td>description</td><td>String?</td><td>Açıklama (opsiyonel)</td></tr>
  <tr><td>status</td><td>String</td><td>ACTIVE / ON_HOLD / COMPLETED (varsayılan: ACTIVE)</td></tr>
  <tr><td>tasks</td><td>Task[]</td><td>Projeye ait görevler (1-N)</td></tr>
</tbody></table>

<h3>Task (Görev)</h3>
<table>
  <tbody><tr><th>Alan</th><th>Tip</th><th>Açıklama</th></tr>
  <tr><td>id</td><td>Int</td><td>Birincil anahtar</td></tr>
  <tr><td>title</td><td>String</td><td>Görev başlığı</td></tr>
  <tr><td>description</td><td>String?</td><td>Açıklama (opsiyonel)</td></tr>
  <tr><td>status</td><td>String</td><td>TODO / IN_PROGRESS / IN_REVIEW / DONE (varsayılan: TODO)</td></tr>
  <tr><td>priority</td><td>String</td><td>LOW / MEDIUM / HIGH / CRITICAL (varsayılan: MEDIUM)</td></tr>
  <tr><td>dueDate</td><td>DateTime?</td><td>Bitiş tarihi (opsiyonel, gecikme kontrolü için kullanılır)</td></tr>
  <tr><td>projectId</td><td>Int (FK)</td><td>Bağlı olduğu proje (zorunlu)</td></tr>
  <tr><td>assigneeId</td><td>Int? (FK)</td><td>Atandığı çalışan (opsiyonel, atanmamış olabilir)</td></tr>
</tbody></table>

<h2>2.3 İlişkiler</h2>
<ul>
  <li>Bir <b>Project</b>, sıfır veya daha fazla <b>Task</b> içerir (1-N, zorunlu FK).</li>
  <li>Bir <b>Employee</b>, sıfır veya daha fazla <b>Task</b>'a atanabilir (1-N, opsiyonel FK).</li>
  <li>Bir <b>Task</b> her zaman tam olarak bir projeye bağlıdır; en fazla bir çalışana atanabilir.</li>
</ul>
</section>

<section id="api-tasarim">
<h1>3. API Tasarım Dokümanı</h1>
<p>Base URL: <code>http://localhost:3000/api</code><br>
Veri formatı: <code>application/json</code></p>

<p>Genel hata formatı:</p>
<pre><code>{ "error": "ValidationError", "message": "...", "details": { } }</code></pre>

<h2>Health</h2>
<table>
  <tbody><tr><th>Method</th><th>Endpoint</th><th>Açıklama</th></tr>
  <tr><td>GET</td><td><code>/health</code></td><td>Servis ayakta mı kontrolü</td></tr>
</tbody></table>

<h2>Employees (Çalışanlar)</h2>
<table>
  <tbody><tr><th>Method</th><th>Endpoint</th><th>Açıklama</th><th>Body</th></tr>
  <tr><td>GET</td><td><code>/employees</code></td><td>Tüm çalışanları listeler</td><td>-</td></tr>
  <tr><td>GET</td><td><code>/employees/:id</code></td><td>Çalışan detayını (atanan görevlerle) getirir</td><td>-</td></tr>
  <tr><td>POST</td><td><code>/employees</code></td><td>Yeni çalışan oluşturur</td><td><code>{ name, email, role? }</code></td></tr>
  <tr><td>PUT</td><td><code>/employees/:id</code></td><td>Çalışan bilgilerini günceller</td><td><code>{ name?, email?, role? }</code></td></tr>
  <tr><td>DELETE</td><td><code>/employees/:id</code></td><td>Çalışanı siler</td><td>-</td></tr>
</tbody></table>

<h2>Projects (Projeler)</h2>
<table>
  <tbody><tr><th>Method</th><th>Endpoint</th><th>Açıklama</th><th>Body</th></tr>
  <tr><td>GET</td><td><code>/projects</code></td><td>Tüm projeleri (görev sayısıyla) listeler</td><td>-</td></tr>
  <tr><td>GET</td><td><code>/projects/:id</code></td><td>Proje detayını (görevlerle) getirir</td><td>-</td></tr>
  <tr><td>POST</td><td><code>/projects</code></td><td>Yeni proje oluşturur</td><td><code>{ name, description?, status? }</code></td></tr>
  <tr><td>PUT</td><td><code>/projects/:id</code></td><td>Proje bilgilerini günceller</td><td><code>{ name?, description?, status? }</code></td></tr>
  <tr><td>DELETE</td><td><code>/projects/:id</code></td><td>Projeyi siler</td><td>-</td></tr>
</tbody></table>

<h2>Tasks (Görevler)</h2>
<table>
  <tbody><tr><th>Method</th><th>Endpoint</th><th>Açıklama</th><th>Body / Query</th></tr>
  <tr><td>GET</td><td><code>/tasks</code></td><td>Görevleri listeler, filtreleme destekler</td><td>Query: <code>status, priority, projectId, assigneeId, overdue, search</code></td></tr>
  <tr><td>GET</td><td><code>/tasks/:id</code></td><td>Görev detayını getirir</td><td>-</td></tr>
  <tr><td>POST</td><td><code>/tasks</code></td><td>Yeni görev oluşturur</td><td><code>{ title, description?, status?, priority?, dueDate?, projectId, assigneeId? }</code></td></tr>
  <tr><td>PUT</td><td><code>/tasks/:id</code></td><td>Görevi günceller (genel)</td><td>Yukarıdaki alanların herhangi bir kombinasyonu</td></tr>
  <tr><td>PATCH</td><td><code>/tasks/:id/assign</code></td><td>Görevi bir çalışana atar / atamayı kaldırır</td><td><code>{ assigneeId: number | null }</code></td></tr>
  <tr><td>PATCH</td><td><code>/tasks/:id/status</code></td><td>Görev durumunu günceller</td><td><code>{ status }</code></td></tr>
  <tr><td>PATCH</td><td><code>/tasks/:id/priority</code></td><td>Görev önceliğini günceller</td><td><code>{ priority }</code></td></tr>
  <tr><td>DELETE</td><td><code>/tasks/:id</code></td><td>Görevi siler</td><td>-</td></tr>
</tbody></table>

<h3>Filtreleme Örnekleri</h3>
<ul>
  <li><code>GET /tasks?status=IN_PROGRESS</code></li>
  <li><code>GET /tasks?priority=HIGH&amp;projectId=1</code></li>
  <li><code>GET /tasks?assigneeId=3</code></li>
  <li><code>GET /tasks?overdue=true</code> → bitiş tarihi geçmiş ve <code>DONE</code> olmayan görevler</li>
  <li><code>GET /tasks?search=doküman</code> → başlığa göre serbest metin arama</li>
</ul>

<h2>Reports (Raporlama)</h2>
<table>
  <tbody><tr><th>Method</th><th>Endpoint</th><th>Açıklama</th></tr>
  <tr><td>GET</td><td><code>/reports/status-summary</code></td><td>Durumlara göre görev sayıları</td></tr>
  <tr><td>GET</td><td><code>/reports/priority-summary</code></td><td>Önceliklere göre görev sayıları</td></tr>
  <tr><td>GET</td><td><code>/reports/employee-workload</code></td><td>Çalışan başına görev sayısı ve durum kırılımı</td></tr>
  <tr><td>GET</td><td><code>/reports/project-progress</code></td><td>Proje başına tamamlanma oranı ve durum kırılımı</td></tr>
  <tr><td>GET</td><td><code>/reports/overdue</code></td><td>Bitiş tarihi geçmiş, tamamlanmamış görevler</td></tr>
</tbody></table>

<h2>HTTP Durum Kodları</h2>
<table>
  <tbody><tr><th>Kod</th><th>Anlamı</th></tr>
  <tr><td>200</td><td>Başarılı (GET/PUT/PATCH)</td></tr>
  <tr><td>201</td><td>Oluşturuldu (POST)</td></tr>
  <tr><td>204</td><td>İçerik yok (DELETE)</td></tr>
  <tr><td>400</td><td>Doğrulama hatası (ValidationError)</td></tr>
  <tr><td>404</td><td>Kayıt bulunamadı (NotFound / AppError)</td></tr>
  <tr><td>500</td><td>Beklenmeyen sunucu hatası</td></tr>
</tbody></table>
</section>

<script>
